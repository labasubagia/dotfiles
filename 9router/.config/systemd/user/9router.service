[Unit]
Description=9Router AI gateway (local only)
After=network-online.target
Wants=network-online.target
Documentation=https://github.com/decolua/9router
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
EnvironmentFile=-%h/.config/9router/env
Environment=PATH=%h/.local/share/fnm/aliases/default/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/share/fnm/aliases/default/bin/9router --host 127.0.0.1 --no-browser --skip-update
Restart=on-failure
RestartSec=5

# Sandboxing
#
# Writable home (deliberate trade-off):
#   9router's dashboard features write OTHER tools' configs under $HOME
#   (~/.claude/config.json, ~/.codex/config.toml, ~/.openclaw/openclaw.json,
#   Cursor OAuth auto-import, ...). ProtectHome=read-only silently broke
#   those, so we allow a writable home via ProtectSystem=strict alone.
#   Trade-off accepted: the gateway process can modify user files, but it
#   cannot touch system dirs / the OS (ProtectSystem=strict), and the
#   server only listens on 127.0.0.1. The ReadWritePaths entries below
#   stay listed explicitly because ProtectSystem=strict would otherwise
#   make that $HOME state read-only (they also document intent).
#   If you ever want the tighter sandbox again, add back:
#     ProtectHome=read-only
#   and wire tools via 'npx 9router connect http://127.0.0.1:20128'.
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=-%h/.9router -%h/.npm %h/.config/9router %h/.cache -%h/.local/share
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=512M
CPUQuota=50%

StandardOutput=journal
StandardError=journal
SyslogIdentifier=9router

[Install]
WantedBy=default.target
