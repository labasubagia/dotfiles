[Unit]
Description=9Router AI gateway (local only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/9router/env
Environment=PATH=%h/.local/share/fnm/aliases/default/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/share/fnm/aliases/default/bin/9router --host 127.0.0.1 --no-browser --skip-update
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
