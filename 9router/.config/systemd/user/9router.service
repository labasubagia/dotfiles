[Unit]
Description=9Router AI gateway (local only)
After=network-online.target
Wants=network-online.target
Documentation=https://github.com/decolua/9router
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
EnvironmentFile=-%h/.config/9router/env
Environment=PATH=%h/.local/share/fnm/aliases/default/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/share/fnm/aliases/default/bin/9router --host 127.0.0.1 --no-browser --skip-update
Restart=on-failure
RestartSec=5

# Sandboxing
#
# ProtectHome=read-only (deliberate trade-off):
#   All 9router state lives under %h/.9router and is allowed above.
#   Known limitation: dashboard features that write OTHER tools' configs
#   (~/.claude/config.json, ~/.codex/config.toml, ~/.openclaw/openclaw.json,
#   Cursor OAuth auto-import, ...) will fail, because $HOME stays read-only.
#   For tool wiring use the CLI instead (runs unsandboxed in your shell):
#     npx 9router connect http://127.0.0.1:20128
# If you ever want full dashboard-config features back (writable home),
# simply delete the ProtectHome=read-only line below; keep
# ProtectSystem=strict.
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=-%h/.9router -%h/.npm %h/.config/9router %h/.cache -%h/.local/share
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=512M
CPUQuota=50%

StandardOutput=journal
StandardError=journal
SyslogIdentifier=9router

[Install]
WantedBy=default.target
